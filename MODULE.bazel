module(
    name = "stemma",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "platforms", version = "1.0.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.95.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//crates/stemmadb:Cargo.toml",
        "//crates/stemma-proto:Cargo.toml",
        "//crates/stemma-ingest:Cargo.toml",
        "//crates/stemma-kg:Cargo.toml",
        "//crates/stemma-embed:Cargo.toml",
        "//crates/stemma-resolve:Cargo.toml",
        "//crates/stemma-lm:Cargo.toml",
        "//crates/stemma-server:Cargo.toml",
        "//crates/stemma-eval:Cargo.toml",
        "//tools/proto-gen:Cargo.toml",
    ],
)
use_repo(crate, "crates")
